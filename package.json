{
  "name": "3rdloop-solutions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:types": "npx -y supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "crawler": "docker compose --env-file .env.local up -d crawl4ai",
    "db:seed": "node --env-file=.env.local scripts/seed-demo-users.ts && node --env-file=.env.local scripts/seed-founders.ts && node --env-file=.env.local scripts/seed-demo-data.ts",
    "db:reset": "npx -y supabase db reset && pnpm db:seed",
    "format": "prettier --write src scripts",
    "db:seed:data": "node --env-file=.env.local scripts/seed-demo-data.ts",
    "db:seed:founders": "node --env-file=.env.local scripts/seed-founders.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pdfmake": "^0.3.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.22.0"
}
