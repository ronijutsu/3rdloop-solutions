NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: account administration (Settings → Team) and the demo seed script
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Internship program site, linked from the sidebar (defaults to https://internship.3rdloopsolutions.com)
NEXT_PUBLIC_INTERNSHIP_URL=https://internship.3rdloopsolutions.com

# OpenRouter — free models only (paid models are rejected at runtime)
OPENROUTER_API_KEY=
# Optional comma-separated fallback chain of free models (defaults in src/lib/ai/client.ts)
OPENROUTER_MODELS=

# Show one-click demo accounts on the login page. Never enable in production.
DEMO_MODE=false

# crawl4ai server (pnpm crawler); the container uses the same token
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=

# Jev by TypeSafe (https://docs.typesafe.ai) — decision verdicts. Paid per input token.
TYPESAFE_API_KEY=
